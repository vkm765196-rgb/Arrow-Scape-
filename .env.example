# -------------------------------------------------------------
# TELEGRAM BOT & WEBAPP CONFIGURATION
# -------------------------------------------------------------

# Telegram Bot Token from @BotFather
# Example: 1234567890:ABCdefGHIJklmNoPQRsTUVwxyZ
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# The HTTPS URL where webapp/index.html is hosted.
# Telegram requires HTTPS (e.g. GitHub Pages, Vercel, or ngrok/localtunnel)
# Example: https://myusername.github.io/arrows-game/
WEBAPP_URL=https://your-domain.com/arrows
